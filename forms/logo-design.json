{
  "id": "logo-design",
  "name": "Logo Design Campaign",
  "title": "Get Your Logo Designed",
  "subtitle": "Tell us about your brand and we'll call you with ideas.",
  "successMessage": "Thank you! Our design team will call you shortly.",
  "errorMessage": "Something went wrong. Please try again or call us directly.",
  "captcha": true,
  "buttonText": "Get Free Consultation",
  "theme": {
    "logo": "https://i.ibb.co/bgWwFzxJ/Kapoore-Art-Logo.jpg",
    "favicon": "https://i.ibb.co/1fmfTKHd/Kapoore-Art-Logo.png",
    "primaryColor": "#6b4226",
    "secondaryColor": "#c9a26d",
    "textColor": "#2b2b2b",
    "bgColor": "#b30000",
    "borderRadius": 13,
    "spacing": 14,
    "fontFamily": "'Poppins', sans-serif"
  },
  "fields": [
    {
      "id": "name",
      "order": 1,
      "type": "text",
      "label": "Full Name",
      "required": true,
      "placeholder": "Enter your name"
    },
    {
      "id": "mobile",
      "order": 2,
      "type": "mobile",
      "label": "Mobile Number",
      "required": true,
      "placeholder": "10-digit mobile number"
    },
    {
      "id": "city",
      "order": 3,
      "type": "text",
      "label": "City",
      "required": false,
      "placeholder": "Your city"
    },
    {
      "id": "business_name",
      "order": 4,
      "type": "text",
      "label": "Business Name",
      "required": true,
      "placeholder": "Your business / brand name"
    },
    {
      "id": "budget",
      "order": 5,
      "type": "dropdown",
      "label": "Budget",
      "required": false,
      "options": [
        "Under ₹2,000",
        "₹2,000 - ₹5,000",
        "₹5,000 - ₹10,000",
        "Above ₹10,000"
      ]
    },
    {
      "id": "message",
      "order": 6,
      "type": "textarea",
      "label": "Message",
      "required": false,
      "placeholder": "Anything we should know?"
    }
  ]
}